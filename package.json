{
  "name": "biolineage",
  "version": "0.1.0",
  "description": "Unified lineage platform for humans, species. clades and historical entities, built on a graph-first ancestry engine.",
  "main": "index.js",
  "scripts": {
    "start": "nodemon index.js"
  },
  "keywords": [
    "genealogy",
    "ancestry",
    "lineage",
    "biology",
    "species",
    "taxonomy",
    "phylogeny",
    "clades",
    "graph",
    "relationships",
    "historical-entities",
    "sovereignity"
  ],
  "author": "Chris Rowley",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/redis": "^9.0.0",
    "@mgcrea/fastify-request-logger": "^1.9.1",
    "@mgcrea/pino-pretty-compact": "^1.6.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "mariadb": "^3.5.4",
    "stylelint": "^17.15.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true
  },
  "nodemonConfig": {
    "ignore": [
      "site/*",
      "util/*",
      "docs/*"
    ]
  }
}
