{
  "name": "biolineage",
  "version": "0.1.0",
  "description": "Unified lineage platform for humans, species. clades and historical entities, built on a graph-first ancestry engine.",
  "main": "index.js",
  "scripts": {
    "start": "nodemon index.js"
  },
  "keywords": [
    "genealogy",
    "ancestry",
    "lineage",
    "biology",
    "species",
    "taxonomy",
    "phylogeny",
    "clades",
    "graph",
    "relationships",
    "historical-entities",
    "sovereignity"
  ],
  "author": "Chris Rowley",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/redis": "^8.0.0",
    "@mgcrea/fastify-request-logger": "^1.9.1",
    "@mgcrea/pino-pretty-compact": "^1.6.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "mariadb": "^3.5.3",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.1": true
  },
  "nodemonConfig": {
    "ignore": [
      "site/*",
      "util/*"
    ]
  }
}
